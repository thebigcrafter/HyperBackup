{
    "name": "thebigcrafter/hyperbackup",
    "description": "HyperBackup creates password-protected ZIP archives of the worlds directory for PocketMine-MP servers.",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Commando.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "thebigcrafter/commando": "^3.3",
        "ext-zip": "*"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.51.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.8"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "thebigcrafter\\HyperBackup\\": "src/"
        }
    },
	"scripts": {
		"analyse": "./vendor/bin/phpstan analyse -c phpstan.neon.dist"
	},
    "authors": [
        {
            "name": "MintoD",
            "email": "tobythedev7@outlook.com"
        }
    ]
}
